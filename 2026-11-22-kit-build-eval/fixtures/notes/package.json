{
  "name": "@notesco/notes-mcp",
  "version": "0.4.0",
  "description": "An MCP server for a small team's notes: list, read, create, update and delete notes kept in a JSON file.",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "notes-mcp": "dist/index.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "vitest run"
  },
  "repository": { "type": "git", "url": "git+https://github.com/notesco/notes-mcp.git" },
  "homepage": "https://github.com/notesco/notes-mcp",
  "author": "Notesco",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
